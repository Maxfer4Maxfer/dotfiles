#!/usr/bin/env bash
# Battery charge for the tmux status bar: "87%" coloured by level, then " ⚡" while on power, a battery icon on battery.
#   battery                  status-bar segment; without a battery of its own (the dev VM) it shows
#                            the host Mac's, exported to $HOST_BATTERY (fresh for 5 min), else nothing
#   battery --export <file>  write "<pct> <ac|discharging>" to <file>; an unchanged value is only
#                            touched, which keeps it fresh for the reader above
#                            (macOS launch agent launchd/com.maxim.battery-export.plist)
HOST_BATTERY=${HOST_BATTERY:-/mnt/vm_shared/.host-battery}

# local battery -> "<pct> <state>", or nothing
local_battery() {
	if command -v pmset >/dev/null; then
		local line
		line=$(pmset -g batt | grep -m1 InternalBattery) || return 0
		printf '%s %s\n' "$(grep -oE '[0-9]+%' <<<"$line" | tr -d %)" \
			"$([[ $line == *discharging* ]] && echo discharging || echo ac)"
		return 0
	fi
	local b
	for b in /sys/class/power_supply/BAT*; do
		[ -r "$b/capacity" ] || continue
		printf '%s %s\n' "$(<"$b/capacity")" "$([ "$(<"$b/status")" = Discharging ] && echo discharging || echo ac)"
		return 0
	done
}

if [ "${1:-}" = --export ]; then
	out=$(local_battery)
	[ -n "$out" ] || exit 0
	if [ "$out" = "$(cat "$2" 2>/dev/null)" ]; then touch "$2"; else printf '%s\n' "$out" >"$2"; fi
	exit 0
fi

bat=$(local_battery)
if [ -z "$bat" ] && [ -r "$HOST_BATTERY" ] &&
	[ $(($(date +%s) - $(stat -c %Y "$HOST_BATTERY" 2>/dev/null || stat -f %m "$HOST_BATTERY"))) -lt 300 ]; then
	bat=$(<"$HOST_BATTERY")
fi
read -r pct state <<<"$bat"
[[ $pct =~ ^[0-9]+$ ]] || exit 0
if [ "$pct" -le 20 ]; then color=red; elif [ "$pct" -le 50 ]; then color=yellow; else color=green; fi
# discharging: a Mac-style battery filled to the nearest tenth, three cells (it starts with its own
# gap after the "%") drawn by battery-font: needs "FiraCode Nerd Font Mono Battery" as iTerm2's Non-ASCII font
levels=(󵼀󵼁󵼂 󵼃󵼄󵼅 󵼆󵼇󵼈 󵼉󵼊󵼋 󵼌󵼍󵼎 󵼏󵼐󵼑 󵼒󵼓󵼔 󵼕󵼖󵼗 󵼘󵼙󵼚 󵼛󵼜󵼝 󵼞󵼟󵼠)
if [ "$state" = ac ]; then icon=" ⚡"; else icon=${levels[(pct + 5) / 10]}; fi
printf '#[fg=%s]%s%%%s' "$color" "$pct" "$icon"
